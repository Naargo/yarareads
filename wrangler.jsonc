{
  "name": "yara-reads",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "account_id": "7485eb8ab648601f411b650cd794bce3",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp", "/.well-known/*", "/oauth/*", "/robots.txt", "/sitemap.xml"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "yara-reads", "database_id": "9d8e4cf4-a64d-4ff3-8cb6-93ebe2156a49" }
  ],
  "r2_buckets": [{ "binding": "PICTURES", "bucket_name": "yara-reads-pictures" }],
  // Workers AI: text to speech for words (cached in R2 under tts/).
  "ai": { "binding": "AI", "remote": true },
  "routes": [{ "pattern": "yarareads.finereli.com", "custom_domain": true }],
  // The public site (no sign-in, our stories only; see publicApi in src/worker.js) turns on when PUBLIC_HOST is a
  // hostname routed to this worker. Empty: off. PUBLIC_INDEX "1" lets crawlers in.
  "vars": { "PUBLIC_HOST": "", "PUBLIC_INDEX": "0" }
  // Secrets (wrangler secret put): FAMILY_EMAIL (the Google account that adopts the pre-accounts data)
}
